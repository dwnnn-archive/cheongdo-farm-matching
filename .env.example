# GitHub Copilot SDK job matching. Leave blank to keep this feature disabled.
COPILOT_GITHUB_TOKEN=

# Microsoft Foundry Agent Framework posting drafts. Leave blank to disable.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=

# Optional on Azure App Service when using a user-assigned managed identity.
AZURE_CLIENT_ID=

# Node server port for local development.
PORT=3001
